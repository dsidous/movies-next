{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "movies-next",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "routes": [
    {
      "pattern": "watch.tamasjonas.com",
      "custom_domain": true,
    },
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "movies-next",
    },
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "796c7b15-2acd-40e3-9e06-700f231f6387",
      "localConnectionString": "postgres://user:pass@localhost:5432/movies",
    },
  ],
}
