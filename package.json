{
  "name": "movies-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bunx tsx db/seed.ts",
    "dev": "next dev",
    "ai-search:setup": "cd ai-search && python3 -m venv .venv && .venv/bin/pip install -r requirements.txt",
    "ai-search:dev": "bash ai-search/dev.sh",
    "format": "bunx prettier --write .",
    "format:check": "bunx prettier --check .",
    "lint": "eslint",
    "start": "next start",
    "tunnel": "ngrok http 3000 --url=chasmogamic-depauperate-darius.ngrok-free.dev",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview:cloudflare": "wrangler dev --env-file .env",
    "deploy:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "postinstall": "node scripts/patch-opennext-init.js"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.2.7",
    "@radix-ui/react-slot": "^1.2.4",
